# Copy to .env for local use. NEVER commit real values.
NODE_ENV=development
PORT=8080
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Leave empty in development to use the local file store (.data/). REQUIRED in production (MongoDB Atlas connection string).
MONGODB_URI=
MONGODB_DB=hatikvah_care
# Public address of the site (used in sitemap.xml), e.g. https://www.hatikvahcare.com
PUBLIC_URL=

# ---------- Automations (reminders, follow-ups, daily summary)
# Runs inside the server every N minutes (0 = off). On Cloud Run (which sleeps when idle) ALSO point Cloud Scheduler at
# POST https://YOUR-DOMAIN/api/internal/cron with header X-Cron-Secret: <CRON_SECRET> every 15 minutes.
AUTOMATION_INTERVAL_MIN=5
CRON_SECRET=

# ---------- Integrations (all optional; until set, messages wait in Admin > Automation with a "Send by hand" link)
# Email via Resend (https://resend.com): verify your domain there, then:
RESEND_API_KEY=
MAIL_FROM=HaTikvah Care <orders@hatikvahcare.com>
MAIL_REPLY_TO=
# WhatsApp Cloud API (Meta Business): permanent token, phone number ID, and an approved template with one {{1}} body variable.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_OTP_TEMPLATE=
# Nova central engine: website login codes on Nova's WhatsApp number (client key from the Nova console)
NOVA_URL=
NOVA_CLIENT_KEY=
NOVA_TENANT_SLUG=
# Razorpay payment links on invoices + webhook (event payment_link.paid → https://YOUR-DOMAIN/api/webhooks/razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: create the first owner on an empty database (both required; the password must meet the policy). Remove afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
