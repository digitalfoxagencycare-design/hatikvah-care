{
  "name": "hatikvah-care",
  "version": "1.0.0",
  "private": true,
  "description": "HaTikvah Care (EXL Marketing): public catalogue website + admin dashboard for hospitality supplies",
  "workspaces": ["apps/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/api",
    "test": "npm test -w apps/api",
    "create-admin": "npm run create-admin -w apps/api --"
  }
}
